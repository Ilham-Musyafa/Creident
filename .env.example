# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# PayPal Sandbox only. Never put Live credentials here.

# PayPal Sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PP_ID=
PP_SECRET=
PP_URL=https://api-m.sandbox.paypal.com

# Optional: set to `simulated` to run money steps against a clearly labelled simulation
# (no PayPal calls, nothing moves). Leave empty to use the PayPal Sandbox keys above.
PAYPAL_MODE=

# Optional, for a shared or hosted demo: reviewer actions then need this code (Settings >
# Reviewer access code). A demo gate, not real authentication.
REVIEWER_ACCESS_CODE=

# Webhook id from the PayPal dashboard (needed to verify webhook signatures)
PP_WEBHOOK_ID=

# AI provider settings (provider not decided yet)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODE=
EVAL_K=

# Deadlines in days. Leave empty for the defaults: ship-by 3, inspection 2, evidence 2.
SHIP_BY_DAYS=
INSPECTION_DAYS=
EVIDENCE_DAYS=
# Days the buyer has to ship the item back after a refund decision (default 3).
RETURN_DAYS=

# Ed25519 private PEM, quoted across multiple lines in .env. Never commit it.
AUDIT_SIGNING_KEY=

# Hosted public demo only: set to 1 together with PAYPAL_MODE=simulated and AI_MODE=replay,
# and leave every secret above empty (the server refuses to start otherwise). See docs/DEPLOY.md.
PUBLIC_DEMO=

# AG Studio local evaluation works without a key; owner adds a trial key 7–8 Nov.
AG_STUDIO_LICENSE_KEY=
