{
  "name": "halcyvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=.env --experimental-strip-types eval/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "smoke": "node --experimental-transform-types --env-file=.env scripts/sandbox-smoke.ts",
    "checkpoint": "node --env-file-if-exists=.env --experimental-strip-types scripts/checkpoint.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
